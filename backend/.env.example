# ── Eldir backend — exemple d'environnement ────────────────────
# Copier vers backend/.env et adapter.

APP_ENV=dev
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database (Postgres en dev/prod)
DATABASE_URL=postgresql+asyncpg://eldir:eldir@localhost:5432/eldir

# Redis
REDIS_URL=redis://localhost:6379/0

# Sécurité — REGÉNÉRER en prod
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Generer via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Workspaces
WORKSPACES_ROOT=/var/eldir/workspaces

# Claude
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6

# Budgets (alerte uniquement, jamais blocage)
DAILY_TOKEN_BUDGET=1000000
DAILY_COST_CAP_USD=8.0
