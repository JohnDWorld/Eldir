# ──────────────── Eldir - variables docker compose ────────────────
#
# Ce fichier est lu par `docker compose` (substitution dans
# docker-compose.yml). Les variables applicatives du backend vivent dans
# `backend/.env` (cf. backend/.env.example).
#
#   cp .env.example .env

# Nom servi par Caddy. Doit résoudre vers ce serveur pour tes appareils.
# Avec le tailnet : un A record public pointant sur l'IP 100.64.0.x suffit,
# rien n'est joignable hors du tailnet.
ELDIR_HOSTNAME=eldir.mondomaine.fr

# IP sur laquelle Caddy écoute. Mets l'IP tailnet du serveur pour qu'Eldir
# ne soit pas exposé sur Internet. 0.0.0.0 pour écouter partout.
ELDIR_BIND_IP=100.64.0.13

# ── Certificat Let's Encrypt par challenge DNS-01 (API OVH) ────────
# Token à créer sur https://api.ovh.com/createToken/ avec, au minimum :
#   GET    /domain/zone/mondomaine.fr/*
#   POST   /domain/zone/mondomaine.fr/*
#   PUT    /domain/zone/mondomaine.fr/*
#   DELETE /domain/zone/mondomaine.fr/*
# Validité : "unlimited", sinon le renouvellement casse dans 3 mois.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# ── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=eldir
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=eldir
