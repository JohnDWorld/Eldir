.DS_Store
.idea/
.vscode/
*.swp
*.log

# secrets
.env
.env.*
!.env.example

# secrets/ : les .env en clair ne sortent jamais d'ici, seuls les
# *.enc.env chiffrés par SOPS (cf. .sops.yaml) sont versionnés.
secrets/*.env
!secrets/*.enc.env

# python (sécurité au cas où ; couvert aussi par backend/.gitignore)
__pycache__/
.venv/

# node (sécurité au cas où ; couvert aussi par frontend/.gitignore)
node_modules/

# generated by docker volumes (rien ne doit traîner ici)
eldir_workspaces/
